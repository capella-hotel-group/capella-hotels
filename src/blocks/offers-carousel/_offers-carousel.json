        {
          "component": "text",
          "name": "eyebrow",
          "label": "Primary Eyebrow Text",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "title",
          "label": "Primary Main Title",
          "valueType": "string",
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "id": "offers-carousel-item",
