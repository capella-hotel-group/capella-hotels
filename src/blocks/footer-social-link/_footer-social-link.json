{
  "definitions": [
    {
      "title": "Footer Social Link",
      "id": "footer-social-link",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Footer Social Link",
              "model": "footer-social-link",
              "filter": "footer-social-link"
            }
          }
        }
      }
    },
    {
      "title": "Footer Social Item",
      "id": "footer-social-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Footer Social Item",
              "model": "footer-social-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "footer-social-link",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Social Links Title",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "footer-social-item",
      "fields": [
        {
          "component": "select",
          "name": "platform",
          "label": "Social Platform",
          "valueType": "string",
          "required": true,
          "options": [
            { "name": "Facebook", "value": "facebook" },
            { "name": "Instagram", "value": "instagram" },
            { "name": "Line", "value": "line" }
          ]
        },
        {
          "component": "reference",
          "name": "icon",
          "label": "Social Media Icon",
          "valueType": "string",
          "required": true,
          "multi": false
        },
        {
          "component": "text",
          "name": "iconAlt",
          "label": "Icon Alt Text",
          "valueType": "string",
          "required": true
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Social Media URL",
          "valueType": "string",
          "required": true
        },
        {
          "component": "boolean",
          "name": "openInNewTab",
          "label": "Open in new tab",
          "valueType": "boolean",
          "value": false
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "footer-social-link",
      "components": ["footer-social-item"]
    }
  ]
}
