{
  "definitions": [
    {
      "title": "Filters Grid",
      "id": "filters-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Filters Grid",
              "model": "filters-grid"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "filters-grid",
      "fields": [
        {
          "component": "text",
          "name": "id",
          "label": "Block ID",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "dataTestId",
          "label": "Data Test ID",
          "valueType": "string",
          "value": "filters-grid"
        },
        {
          "component": "text",
          "name": "eyebrow",
          "label": "Eyebrow",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "title",
          "label": "Title",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "cfRootPath",
          "label": "Content Fragment's Root Path",
          "description": "Select a Content Fragment folder or path prefix. Only matching published cards are requested; a blank path requests all cards.",
          "valueType": "string",
          "required": true
        },
        {
          "component": "container",
          "name": "filterModeLabels",
          "label": "Filter Mode Labels",
          "description": "Add one entry per filter mode and select its root tag. When multiple modes are shown, provide a label for each. Child tags are used as category filters.",
          "multi": true,
          "fields": [
            {
              "component": "text",
              "name": "label",
              "label": "Mode Label",
              "valueType": "string",
              "required": false
            },
            {
              "component": "aem-tag",
              "name": "rootTag",
              "label": "Root Tag",
              "valueType": "string",
              "multi": false,
              "required": true
            }
          ]
        },
        {
          "component": "container",
          "name": "categorySettings",
          "label": "Category Settings",
          "description": "Choose a category tag, its background colour, and optionally the default category. Suggested colours: Green for Nature.",
          "multi": true,
          "fields": [
            {
              "component": "aem-tag",
              "name": "categoryTag",
              "label": "Category Tag",
              "valueType": "string",
              "multi": false,
              "required": true
            },
            {
              "component": "select",
              "name": "backgroundColor",
              "label": "Background Color",
              "valueType": "string",
              "required": true,
              "value": "white",
              "options": [
                { "name": "Dark brown", "value": "dark-brown" },
                { "name": "Light brown", "value": "light-brown" },
                { "name": "Green", "value": "green" },
                { "name": "Pink", "value": "pink" },
                { "name": "Blue", "value": "blue" },
                { "name": "White", "value": "white" }
              ]
            },
            {
              "component": "boolean",
              "name": "isDefaultCategory",
              "label": "Default Category",
              "description": "Select the category to show initially. Its mode will also be selected. If more than one is selected, the first one wins.",
              "valueType": "boolean",
              "value": false
            }
          ]
        },
        {
          "component": "boolean",
          "name": "showModeLabels",
          "label": "Show Filter Mode Labels",
          "description": "This setting applies to all mode labels. If enabled, provide labels when multiple modes are displayed. If hidden, the configured default category and its mode remain active.",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "text",
          "name": "revealMoreLabel",
          "label": "Reveal More CTA Text",
          "valueType": "string",
          "value": "Reveal More"
        }
      ]
    }
  ],
  "filters": []
}
