{
  "definitions": [
    {
      "title": "Filters Grid",
      "id": "filters-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Filters Grid",
              "model": "filters-grid",
              "filter": "filters-grid"
            }
          }
        }
      }
    },
    {
      "title": "Filter Tab",
      "id": "filters-grid-tab",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Filter Tab",
              "model": "filters-grid-tab"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "filters-grid",
      "fields": [
        {
          "component": "text",
          "name": "id",
          "label": "Block ID",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "dataTestId",
          "label": "Data Test ID",
          "valueType": "string",
          "value": "filters-grid"
        },
        {
          "component": "text",
          "name": "eyebrow",
          "label": "Eyebrow",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "title",
          "label": "Title",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "cfRootPath",
          "label": "Content Fragment's Root Path",
          "description": "Choose a Content Fragment folder or path prefix to request matching published cards. Leave blank for all cards.",
          "valueType": "string",
          "required": true
        },
        {
          "component": "boolean",
          "name": "showModeLabels",
          "label": "Show Filter Tab Labels",
          "description": "Show or hide all tab labels. Multiple visible tabs need labels. When hidden, the default category and tab stay active.",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "text",
          "name": "revealMoreLabel",
          "label": "Reveal More CTA Text",
          "valueType": "string",
          "value": "Reveal More"
        }
      ]
    },
    {
      "id": "filters-grid-tab",
      "fields": [
        {
          "component": "text",
          "name": "label",
          "label": "Tab Label",
          "description": "Provide a label when multiple tabs are displayed.",
          "valueType": "string",
          "required": false
        },
        {
          "component": "container",
          "name": "categorySettings",
          "label": "Category Settings",
          "description": "Add filters in order; the default appears first.",
          "multi": true,
          "fields": [
            {
              "component": "boolean",
              "name": "isDefaultCategory",
              "label": "Default Category",
              "description": "Show this category first and activate its tab. For multiple defaults, use the first tab with a default and its first default category.",
              "valueType": "boolean",
              "value": false
            },
            {
              "component": "aem-tag",
              "name": "categoryTag",
              "label": "Category Tag",
              "valueType": "string",
              "multi": false,
              "required": true
            },
            {
              "component": "select",
              "name": "backgroundColor",
              "label": "Background Color",
              "description": "Suggested colour: Green for Nature.",
              "valueType": "string",
              "required": true,
              "value": "white",
              "options": [
                { "name": "Dark brown", "value": "dark-brown" },
                { "name": "Light brown", "value": "light-brown" },
                { "name": "Green", "value": "green" },
                { "name": "Pink", "value": "pink" },
                { "name": "Blue", "value": "blue" },
                { "name": "White", "value": "white" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "filters-grid",
      "components": ["filters-grid-tab"]
    }
  ]
}
