{
  "definitions": [
    {
      "title": "Filters Grid",
      "id": "filters-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Filters Grid",
              "model": "filters-grid",
              "filter": "filters-grid"
            }
          }
        }
      }
    },
    {
      "title": "Filter Tab",
      "id": "filters-grid-tab",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Filter Tab",
              "model": "filters-grid-tab"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "filters-grid",
      "fields": [
        {
          "component": "text",
          "name": "id",
          "label": "Block ID",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "dataTestId",
          "label": "Data Test ID",
          "valueType": "string",
          "value": "filters-grid"
        },
        {
          "component": "text",
          "name": "eyebrow",
          "label": "Eyebrow",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "title",
          "label": "Title",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "cfRootPath",
          "label": "Content Fragment's Root Path",
          "description": "Select the folder containing the Content Fragments you want to display in this grid.",
          "valueType": "string",
          "required": true
        },
        {
          "component": "boolean",
          "name": "showModeLabels",
          "label": "Show Filter Tab Labels",
          "description": "Toggle to display filter tabs above the grid. When hidden, cards from the default category are shown automatically",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "text",
          "name": "revealMoreLabel",
          "label": "Reveal More CTA Text",
          "description": "Label for the load-more button (defaults to 'Reveal More').",
          "valueType": "string",
          "value": "Reveal More"
        },
        {
          "component": "boolean",
          "name": "showModalEyebrow",
          "label": "Show Modal Eyebrow",
          "description": "Show or hide the eyebrow text inside detail popups.",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "boolean",
          "name": "showModalCategoryTag",
          "label": "Show Modal Category Tag",
          "description": "Show or hide category tags inside detail popups.",
          "valueType": "boolean",
          "value": true
        }
      ]
    },
    {
      "id": "filters-grid-tab",
      "fields": [
        {
          "component": "text",
          "name": "label",
          "label": "Tab Label",
          "description": "Provide a label when multiple tabs are displayed.",
          "valueType": "string",
          "required": false
        },
        {
          "component": "container",
          "name": "categorySettings",
          "label": "Category Settings",
          "description": "Add filters in order; the default appears first.",
          "multi": true,
          "fields": [
            {
              "component": "aem-tag",
              "name": "categoryTag",
              "label": "Category Tag",
              "description": "Select one tag per category. Complete this field before publishing.",
              "valueType": "string",
              "multi": false,
              "required": false
            },
            {
              "component": "select",
              "name": "backgroundColor",
              "label": "Background Color",
              "description": "Suggested colour: Green for Nature.",
              "valueType": "string",
              "required": false,
              "value": "white",
              "options": [
                { "name": "Dark brown", "value": "dark-brown" },
                { "name": "Light brown", "value": "light-brown" },
                { "name": "Green", "value": "green" },
                { "name": "Pink", "value": "pink" },
                { "name": "Blue", "value": "blue" },
                { "name": "White", "value": "white" }
              ]
            },
            {
              "component": "boolean",
              "name": "isDefaultCategory",
              "label": "Default Category",
              "description": "Select to show this category first and open its tab on load. Choose one default; if several are selected, the first tab with a default and its first default category are used.",
              "valueType": "boolean",
              "value": false
            }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "filters-grid",
      "components": ["filters-grid-tab"]
    }
  ]
}
