{
  "definitions": [
    {
      "title": "Booking Search",
      "id": "booking-search",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Booking Search",
              "model": "booking-search",
              "filter": "booking-search"
            }
          }
        }
      }
    },
    {
      "title": "Booking Search Location",
      "id": "booking-search-location",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Location",
              "model": "booking-search-location"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "booking-search",
      "fields": [
        {
          "component": "text",
          "name": "id",
          "label": "Block ID",
          "description": "Sets the id attribute on the block, usable as an anchor target.",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "text",
          "name": "dataTestId",
          "label": "Data Test ID",
          "description": "Adds a data-test-id attribute on the block for QA automation. Leave empty to omit it.",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "text",
          "name": "locationLabel",
          "label": "Location Label",
          "description": "Shown on the selector until a location is picked.",
          "valueType": "string",
          "required": true,
          "value": "LOCATION"
        },
        {
          "component": "text",
          "name": "datesLabel",
          "label": "Arrival/Depart Label",
          "description": "Shown on the selector until both dates are picked.",
          "valueType": "string",
          "required": true,
          "value": "ARRIVAL/DEPART"
        },
        {
          "component": "text",
          "name": "guestSingularLabel",
          "label": "Guest Label (singular)",
          "description": "Used after the number when exactly one guest is selected.",
          "valueType": "string",
          "required": true,
          "value": "GUEST"
        },
        {
          "component": "text",
          "name": "guestPluralLabel",
          "label": "Guests Label (plural)",
          "valueType": "string",
          "required": true,
          "value": "GUESTS"
        },
        {
          "component": "text",
          "name": "adultsLabel",
          "label": "Adults Counter Label",
          "valueType": "string",
          "required": true,
          "value": "Adult"
        },
        {
          "component": "text",
          "name": "childrenLabel",
          "label": "Children Counter Label",
          "valueType": "string",
          "required": true,
          "value": "Children"
        },
        {
          "component": "text",
          "name": "checkRatesLabel",
          "label": "Check Rates Label",
          "valueType": "string",
          "required": true,
          "value": "Check rates"
        },
        {
          "component": "text",
          "name": "bookingUrl",
          "label": "Booking Engine URL",
          "description": "Absolute https URL. The selected dates, guests and location are appended as query parameters.",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "boolean",
          "name": "checkRatesOpenInNewTab",
          "label": "Open Check Rates in New Tab",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "text",
          "name": "doneLabel",
          "label": "Done Button Label",
          "description": "Closes the open selector flyout.",
          "valueType": "string",
          "required": true,
          "value": "Done"
        },
        {
          "component": "number",
          "name": "maxAdults",
          "label": "Max Adults",
          "description": "Highest adult count the guests flyout allows (1-20). Totals of 10 or more guests no longer fit the selector label.",
          "valueType": "number",
          "value": 6
        },
        {
          "component": "number",
          "name": "maxChildren",
          "label": "Max Children",
          "description": "Highest child count the guests flyout allows (0-20).",
          "valueType": "number",
          "value": 3
        }
      ]
    },
    {
      "id": "booking-search-location",
      "fields": [
        {
          "component": "text",
          "name": "label",
          "label": "Location Name",
          "description": "Shown in the list and on the selector once picked. Keep it short, e.g. a city name.",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "text",
          "name": "code",
          "label": "Property Code",
          "description": "Sent to the booking engine for this location. Falls back to the name when empty.",
          "valueType": "string",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "booking-search",
      "components": ["booking-search-location"]
    }
  ]
}
