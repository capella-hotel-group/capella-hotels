{
  "definitions": [
    {
      "title": "Destination Introduction",
      "id": "destination-introduction",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Destination Introduction",
              "model": "destination-introduction",
              "filter": "destination-introduction"
            }
          }
        }
      }
    },
    {
      "title": "Destination Introduction Media",
      "id": "destination-introduction-image",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Destination Introduction Media",
              "model": "destination-introduction-image"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "destination-introduction",
      "fields": [
        {
          "component": "text",
          "name": "id",
          "label": "Component Anchor ID",
          "description": "Sets the id attribute on the block, usable as an anchor target.",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "text",
          "name": "dataTestId",
          "label": "Data Test ID",
          "description": "Adds a data-test-id attribute on the block for QA automation. Leave empty to omit it.",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "text",
          "name": "eyebrow",
          "label": "Eyebrow",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "title",
          "label": "Title",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "richtext",
          "name": "body",
          "label": "Body",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "text",
          "name": "footerCta",
          "label": "Footer CTA Label",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "aem-content",
          "name": "footerCta_link",
          "label": "Footer CTA URL",
          "valueType": "string"
        },
        {
          "component": "boolean",
          "name": "footerCta_openInNewTab",
          "label": "Open in new tab",
          "valueType": "boolean",
          "value": false
        }
      ]
    },
    {
      "id": "destination-introduction-image",
      "fields": [
        {
          "component": "reference",
          "name": "thumbnail",
          "label": "Thumbnail",
          "description": "Still image only. Doubles as the poster when the media is a video.",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "thumbnailAlt",
          "label": "Thumbnail Alt Text",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "select",
          "name": "media",
          "label": "Media Type",
          "valueType": "string",
          "multi": false,
          "required": true,
          "value": "image",
          "options": [
            { "name": "Image", "value": "image" },
            { "name": "Video", "value": "video" }
          ]
        },
        {
          "component": "reference",
          "name": "mediaAsset",
          "label": "Media",
          "description": "Max 10 seconds, WebM or MP4. The size of the video should be within 1.5MB & upto 1080 pixels",
          "valueType": "string",
          "multi": false,
          "required": true
        },
        {
          "component": "text",
          "name": "mediaAssetAlt",
          "label": "Media Alt Text",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "boolean",
          "name": "darkOverlay",
          "label": "Enable Dark Image Overlay",
          "description": "Tints this media so overlaid text stays legible. Does not affect the thumbnail.",
          "valueType": "boolean",
          "value": false
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "destination-introduction",
      "components": ["destination-introduction-image"],
      "minItems": 1,
      "maxItems": 3,
      "customErrorMsg": "Add between 1 and 3 media items."
    }
  ]
}
