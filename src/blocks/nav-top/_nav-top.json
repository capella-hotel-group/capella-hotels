{
  "definitions": [
    {
      "title": "Nav Top (Demo)",
      "id": "nav-top",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Nav Top",
              "model": "nav-top"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "nav-top",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "Nav Type",
          "valueType": "string",
          "required": true,
          "value": "global",
          "options": [
            { "name": "Global", "value": "global" },
            { "name": "Destination", "value": "destination" }
          ]
        },
        {
          "component": "reference",
          "name": "logo",
          "label": "Logo (menu closed)",
          "valueType": "string",
          "required": true,
          "multi": false
        },
        {
          "component": "text",
          "name": "logoAlt",
          "label": "Logo Alt Text (brand name)",
          "valueType": "string",
          "required": true
        },
        {
          "component": "reference",
          "name": "logoActive",
          "label": "Logo (menu open) — empty uses Logo",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "reference",
          "name": "logoSimple",
          "label": "Logo (sticky) — empty uses Logo",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "aem-content",
          "name": "home_link",
          "label": "Logo Link — empty uses current language home",
          "valueType": "string"
        },
        {
          "component": "boolean",
          "name": "home_openInNewTab",
          "label": "Logo Link: Open in New Tab",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "text",
          "name": "menu_openLabel",
          "label": "Menu Button Label",
          "valueType": "string",
          "required": true,
          "value": "Menu"
        },
        {
          "component": "text",
          "name": "menu_closeLabel",
          "label": "Close Button Label",
          "valueType": "string",
          "required": true,
          "value": "Close"
        },
        {
          "component": "aem-content",
          "name": "cta_link",
          "label": "CTA Link",
          "valueType": "string",
          "required": true
        },
        {
          "component": "text",
          "name": "cta_linkText",
          "label": "CTA Label",
          "valueType": "string",
          "required": true,
          "value": "Book"
        },
        {
          "component": "boolean",
          "name": "cta_openInNewTab",
          "label": "CTA: Open in New Tab",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "back_link",
          "label": "Back Link",
          "valueType": "string",
          "required": true,
          "condition": {
            "===": [{ "var": "classes" }, "destination"]
          }
        },
        {
          "component": "text",
          "name": "back_linkText",
          "label": "Back Label — empty shows \"BACK\"",
          "valueType": "string",
          "condition": {
            "===": [{ "var": "classes" }, "destination"]
          }
        },
        {
          "component": "container",
          "name": "languages",
          "label": "Languages",
          "multi": true,
          "fields": [
            {
              "component": "aem-content",
              "name": "link",
              "label": "Language URL",
              "valueType": "string",
              "required": true
            },
            {
              "component": "text",
              "name": "linkText",
              "label": "Language Label",
              "valueType": "string",
              "required": true
            },
            {
              "component": "boolean",
              "name": "openInNewTab",
              "label": "Open in New Tab",
              "valueType": "boolean",
              "value": false
            }
          ]
        }
      ]
    }
  ],
  "filters": []
}
