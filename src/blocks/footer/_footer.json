  "models": [
    {
      "id": "footer",
      "fields": [
        {
          "component": "select",
          "name": "backgroundTheme",
          "label": "Background Color Theme",
          "valueType": "string",
          "required": true,
          "value": "light-sand",
          "options": [
            { "name": "Light Sand / Beige", "value": "light-sand" },
            { "name": "Clean White", "value": "clean-white" }
          ]
        }
      ]
    },
    {
      "id": "footer-contact",
      "fields": [
        {
          "component": "richtext",
          "name": "contactContent",
          "label": "Contact Information",
          "valueType": "string",
          "required": true
        }
      ]
    },
    {
      "id": "footer-social-link",
      "fields": [
        {
          "component": "reference",
          "name": "icon",
          "label": "Social Media Icon",
          "valueType": "string",
          "required": true,
          "multi": false
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Social Media URL",
          "valueType": "string",
          "required": true
        },
        {
          "component": "boolean",
          "name": "openInNewTab",
          "label": "Open in new tab",
          "valueType": "boolean",
          "value": false
        }
      ]
    },
    {
      "id": "footer-links",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Link Group Title",
          "valueType": "string"
        },
        {
          "component": "number",
          "name": "itemsPerColumn",
          "label": "Items Before Second Column",
          "description": "Number of brand navigation links to show in the first column before continuing in the second column.",
          "valueType": "number",
          "value": 5,
          "numberMin": 1,
          "numberMax": 8
        }
      ]
    },
    {
      "id": "footer-link",
      "fields": [
        {
          "component": "text",
          "name": "label",
          "label": "Link Label",
          "valueType": "string",
          "required": true
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link URL",
          "valueType": "string",
          "required": true
        },
        {
          "component": "boolean",
          "name": "openInNewTab",
          "label": "Open in new tab",
          "valueType": "boolean",
          "value": false
        }
      ]
    },
    {
      "id": "footer-bottom",
      "fields": [
        {
          "component": "text",
          "name": "copyrightText",
          "label": "Copyright Text",
          "valueType": "string",
          "required": true,
          "value": "© 2026 Capella Hotel Group. All Rights Reserved."
        }
      ]
    },
    {
      "id": "footer-utility-link",
      "fields": [
        {
          "component": "text",
          "name": "label",
          "label": "Utility Link Label",
          "valueType": "string",
          "required": true
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Utility Link URL",
          "valueType": "string",
          "required": true
        },
        {
          "component": "boolean",
          "name": "openInNewTab",
          "label": "Open in new tab",
          "valueType": "boolean",
          "value": false
        }
      ]
    }
