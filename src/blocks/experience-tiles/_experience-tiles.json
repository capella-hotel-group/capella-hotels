{
  "definitions": [
    {
      "title": "Experience Tiles",
      "id": "experience-tiles",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Experience Tiles",
              "filter": "experience-tiles",
              "model": "experience-tiles"
            }
          }
        }
      }
    },
    {
      "title": "Experience Tiles Slide",
      "id": "experience-tiles-slide",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Experience Tiles Slide",
              "model": "experience-tiles-slide"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "experience-tiles",
      "fields": [
        {
          "component": "text",
          "name": "id",
          "valueType": "string",
          "label": "Block ID",
          "description": "Sets the id attribute on the block, usable as an anchor target.",
          "value": "",
          "placeholder": "e.g., experience-tiles"
        },
        {
          "component": "text",
          "name": "dataTestId",
          "valueType": "string",
          "label": "Automation Key",
          "description": "Adds a data-automation-key attribute so QA can target this instance. Leave empty to omit it.",
          "value": "",
          "placeholder": "e.g., homepage-experiences"
        }
      ]
    },
    {
      "id": "experience-tiles-slide",
      "fields": [
        {
          "component": "reference",
          "name": "leftMedia_image",
          "label": "Left Panel Image",
          "valueType": "string",
          "multi": false,
          "required": true
        },
        {
          "component": "text",
          "name": "leftMedia_imageAlt",
          "label": "Left Panel Asset Alt Text",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "boolean",
          "name": "leftMedia_overlay",
          "label": "Left Panel Image Overlay",
          "description": "Adds a dark gradient over the bottom of the image to keep the text legible.",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "text",
          "name": "leftContent_eyebrow",
          "label": "Left Panel Eyebrow",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "text",
          "name": "leftContent_headline",
          "label": "Left Panel Headline",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "reference",
          "name": "rightMedia_image",
          "label": "Right Panel Image",
          "valueType": "string",
          "multi": false,
          "required": true
        },
        {
          "component": "text",
          "name": "rightMedia_imageAlt",
          "label": "Right Panel Asset Alt Text",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "boolean",
          "name": "rightMedia_overlay",
          "label": "Right Panel Image Overlay",
          "description": "Adds a dark gradient over the bottom of the image to keep the text legible.",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "text",
          "name": "rightContent_headline",
          "label": "Right Panel Headline",
          "valueType": "string",
          "required": true,
          "value": ""
        },
        {
          "component": "richtext",
          "name": "rightContent_description",
          "label": "Right Panel Description",
          "description": "Leave empty for a panel that shows only a headline.",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "aem-content",
          "name": "rightCtas_primaryCta",
          "label": "Right Panel Primary Link URL",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "rightCtas_primaryCtaText",
          "label": "Right Panel Primary Link Label",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "boolean",
          "name": "rightCtas_primaryCtaOpenInNewTab",
          "label": "Right Panel Primary Link Open in new tab",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "rightCtas_secondaryCta",
          "label": "Right Panel Secondary Link URL",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "rightCtas_secondaryCtaText",
          "label": "Right Panel Secondary Link Label",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "boolean",
          "name": "rightCtas_secondaryCtaOpenInNewTab",
          "label": "Right Panel Secondary Link Open in new tab",
          "valueType": "boolean",
          "value": false
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "experience-tiles",
      "components": ["experience-tiles-slide"],
      "minItems": 1,
      "customErrorMsg": "Add at least 1 slide."
    }
  ]
}
