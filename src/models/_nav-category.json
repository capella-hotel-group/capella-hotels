{
  "definitions": [
    {
      "title": "Nav Category (Demo)",
      "id": "nav-category",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "name": "Nav Category",
              "model": "nav-category",
              "filter": "nav-category"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "nav-category",
      "fields": [
        {
          "component": "text",
          "name": "name",
          "label": "Section Name",
          "description": "The label shown for this section in the Content Tree",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "title",
          "label": "Category Title",
          "valueType": "string",
          "required": true
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Category Link — only for a category without regions",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "promoImage",
          "label": "Promo Image",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "promoImageDescription",
          "label": "Promo Image Alt Text",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "promoCtaLabel",
          "label": "Promo CTA Label",
          "valueType": "string",
          "value": "EXPLORE MORE"
        },
        {
          "component": "aem-content",
          "name": "promoLink",
          "label": "Promo CTA Link",
          "valueType": "string"
        },
        {
          "component": "boolean",
          "name": "promoOpenInNewTab",
          "label": "Promo CTA: Open in New Tab",
          "valueType": "boolean",
          "value": false
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "nav-category",
      "components": ["nav-region", "nav-region-rte"]
    }
  ]
}
